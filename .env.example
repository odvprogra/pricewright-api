# Copy to .env for local development. Never commit .env: it is git-ignored.

# local | test | staging | production
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# json (deployed) | console (readable, for local development)
LOG_FORMAT=console

# HTTP server bind address (0.0.0.0 inside a container)
HOST=127.0.0.1
PORT=8000

# postgres:// and postgresql:// URLs are accepted too (converted to the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/pricewright
